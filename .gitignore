# ── dependencies ──────────────────────────────────────────────
node_modules/

# ── build output ──────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ── environment & secrets (never commit these) ────────────────
.env
.env.*
!.env.example
.env.local
.env.production
.env.development

# ── convex (regenerated on `convex dev` / `convex deploy`) ────
src/convex/_generated/
.convex-data/
convex.json
!.convex.json.example

# ── editors / OS ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp
*.swo

# ── logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# ── testing / coverage ────────────────────────────────────────
coverage/
